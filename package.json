{
  "name": "github-plugin-updater",
  "version": "1.5.1",
  "description": "Download ZIP releases of followed GitHub Decky plugins.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "github",
    "updates"
  ],
  "author": "Fabian Petrusky",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=16.14.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "5.1.20",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
